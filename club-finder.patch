diff --git a/client/src/club-finder.css b/client/src/club-finder.css
new file mode 100644
index 0000000..6a17136
--- /dev/null
+++ b/client/src/club-finder.css
@@ -0,0 +1,72 @@
+/* ---------- club finder (append to styles.css) ---------- */
+.cf { position: fixed; right: 20px; bottom: 20px; z-index: 60; display: flex; flex-direction: column; align-items: flex-end; gap: 12px; }
+.cf-launcher { position: relative; display: block; padding: 0; border: 0; background: none; cursor: pointer; border-radius: 50%; }
+.cf-launcher:focus-visible { outline: 3px solid var(--ink); outline-offset: 4px; }
+.cf-avatar { display: grid; place-items: center; width: 64px; height: 64px; border-radius: 50%; overflow: hidden; background: var(--cardinal); box-shadow: 0 0 0 3px var(--gold), 0 8px 24px rgba(60, 0, 0, 0.28); transition: transform 120ms ease-out; }
+.cf-avatar img { width: 100%; height: 100%; object-fit: cover; }
+.cf-avatar-x { color: var(--paper); font-size: 30px; line-height: 1; }
+.cf-launcher:hover .cf-avatar { transform: scale(1.05); }
+.cf-launcher.open .cf-avatar { width: 52px; height: 52px; box-shadow: 0 0 0 3px var(--gold-soft); }
+
+/* Thought bubble up and to the left of the avatar, trailing two dots back to it. */
+.cf-thought { position: absolute; right: 54px; bottom: 66px; padding: 9px 15px; white-space: nowrap; background: var(--paper); color: var(--cardinal-dark); font-weight: 600; font-size: 14px; border: 2px solid var(--cardinal); border-radius: 22px; box-shadow: 0 6px 18px rgba(60, 0, 0, 0.16); animation: cf-think 2.4s ease-in-out 0.4s 2; }
+.cf-thought-dot { position: absolute; border-radius: 50%; background: var(--paper); border: 2px solid var(--cardinal); }
+.cf-thought-dot.big { width: 13px; height: 13px; right: 4px; bottom: -15px; }
+.cf-thought-dot.small { width: 8px; height: 8px; right: -6px; bottom: -26px; }
+@keyframes cf-think { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
+
+.cf-panel { width: min(400px, calc(100vw - 40px)); height: min(600px, calc(100vh - 110px)); display: flex; flex-direction: column; background: var(--paper); border: 1px solid var(--line-2); border-radius: 16px; box-shadow: 0 18px 48px rgba(40, 0, 0, 0.22); overflow: hidden; transform-origin: bottom right; animation: cf-open 160ms ease-out; }
+@keyframes cf-open { from { opacity: 0; transform: translateY(8px) scale(0.98); } }
+
+.cf-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; padding: 14px 14px 12px 18px; background: var(--cardinal); color: var(--paper); border-bottom: 3px solid var(--gold); }
+.cf-title { margin: 0; font-size: 17px; line-height: 1.2; color: inherit; }
+.cf-sub { margin: 2px 0 0; font-size: 13px; opacity: 0.85; }
+.cf-head-actions { display: flex; align-items: center; gap: 4px; }
+.cf-head .btn.ghost { color: var(--paper); }
+.cf-close { width: 32px; height: 32px; border: 0; border-radius: 8px; background: transparent; color: var(--paper); font-size: 22px; line-height: 1; cursor: pointer; }
+.cf-close:hover, .cf-close:focus-visible { background: rgba(255, 255, 255, 0.15); }
+
+.cf-log { flex: 1; overflow-y: auto; padding: 16px; display: flex; flex-direction: column; gap: 10px; background: var(--paper-2); }
+.cf-msg { max-width: 88%; padding: 9px 13px; border-radius: 14px; font-size: 14px; line-height: 1.45; }
+.cf-msg p { margin: 0; white-space: pre-wrap; }
+.cf-msg.bot { align-self: flex-start; background: var(--paper); border: 1px solid var(--line-2); border-bottom-left-radius: 4px; color: var(--ink); }
+.cf-msg.me { align-self: flex-end; background: var(--cardinal); color: var(--paper); border-bottom-right-radius: 4px; }
+
+.cf-matches { list-style: none; margin: 10px 0 2px; padding: 0; display: grid; gap: 8px; }
+.cf-match { padding: 10px 12px; border-left: 3px solid var(--gold); background: var(--paper-2); border-radius: 0 8px 8px 0; }
+.cf-match-top { display: flex; justify-content: space-between; align-items: baseline; gap: 8px; }
+.cf-match-name { font-weight: 600; color: var(--cardinal-dark); }
+.cf-fit { flex-shrink: 0; font-size: 12px; font-weight: 600; padding: 1px 7px; border-radius: 6px; }
+.cf-fit.strong { background: var(--gold-soft); color: var(--cardinal-dark); }
+.cf-fit.good { background: var(--paper); color: var(--ink-2); border: 1px solid var(--line-2); }
+.cf-reason { margin: 3px 0 0; font-size: 13px; color: var(--ink-2); }
+
+.cf-typing { display: inline-flex; gap: 4px; padding: 12px 14px; }
+.cf-typing span { width: 7px; height: 7px; border-radius: 50%; background: var(--ink-3); animation: cf-dot 1s infinite ease-in-out; }
+.cf-typing span:nth-child(2) { animation-delay: 0.15s; }
+.cf-typing span:nth-child(3) { animation-delay: 0.3s; }
+@keyframes cf-dot { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }
+
+.cf-chips { display: flex; flex-wrap: wrap; gap: 6px; padding: 10px 14px 0; border-top: 1px solid var(--line-2); background: var(--paper); }
+.cf-chip { padding: 5px 11px; border: 1px solid var(--line-2); border-radius: 999px; background: var(--paper); color: var(--ink); font: inherit; font-size: 13px; cursor: pointer; }
+.cf-chip:hover { border-color: var(--cardinal); }
+.cf-chip.on { background: var(--gold-soft); border-color: var(--cardinal); color: var(--cardinal-dark); font-weight: 600; }
+.cf-chip:focus-visible { outline: 2px solid var(--cardinal); outline-offset: 2px; }
+.cf-continue { margin-left: auto; }
+
+.cf-error { margin: 8px 14px 0; }
+.cf-compose { display: flex; gap: 8px; padding: 10px 14px 14px; background: var(--paper); }
+.cf-compose .input { flex: 1; min-width: 0; }
+
+@media (max-width: 560px) {
+  .cf { right: 12px; bottom: 12px; }
+  .cf-panel { position: fixed; inset: 0; width: 100%; height: 100%; border-radius: 0; border: 0; }
+  .cf-launcher.open { display: none; }
+  .cf-avatar { width: 56px; height: 56px; }
+  .cf-thought { right: 46px; bottom: 58px; font-size: 13px; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .cf-panel, .cf-thought { animation: none; }
+  .cf-avatar { transition: none; }
+  .cf-typing span { animation: none; opacity: 0.6; }
+}
diff --git a/client/src/clubFinderApi.ts b/client/src/clubFinderApi.ts
new file mode 100644
index 0000000..1062f67
--- /dev/null
+++ b/client/src/clubFinderApi.ts
@@ -0,0 +1,34 @@
+// Club finder transport. Same-origin, cookie session, like api.ts.
+export interface FinderProfile { major: string; interests: string[]; skills: string }
+export interface ResumeUpload { fileName: string; mediaType: "application/pdf" | "text/plain"; data: string }
+export interface FinderTurn { role: "user" | "assistant"; content: string }
+export interface FinderMatch { clubId: string; name: string; reason: string; fit: "strong" | "good" }
+export interface FinderReply { reply: string; matches: FinderMatch[]; resumeSummary?: string }
+
+export const MAX_RESUME_BYTES = 5 * 1024 * 1024;
+
+export async function findClubs(body: { profile: FinderProfile; resume?: ResumeUpload; resumeSummary?: string; history: FinderTurn[] }): Promise<FinderReply> {
+  const response = await fetch("/api/club-finder", {
+    method: "POST",
+    credentials: "same-origin",
+    headers: { "Content-Type": "application/json" },
+    body: JSON.stringify(body),
+  });
+  const data = await response.json().catch(() => ({}));
+  if (!response.ok) throw new Error(typeof data?.error === "string" ? data.error : "The club finder couldn't answer. Try again.");
+  return data as FinderReply;
+}
+
+/** Reads a PDF or .txt résumé into base64 in memory. Nothing is saved in the browser. */
+export function readResume(file: File): Promise<ResumeUpload> {
+  const mediaType = file.type === "application/pdf" || /\.pdf$/i.test(file.name) ? "application/pdf"
+    : file.type === "text/plain" || /\.txt$/i.test(file.name) ? "text/plain" : null;
+  if (!mediaType) return Promise.reject(new Error("Upload your résumé as a PDF or .txt file."));
+  if (file.size > MAX_RESUME_BYTES) return Promise.reject(new Error("That file is over 5 MB. Upload a smaller PDF."));
+  return new Promise((resolve, reject) => {
+    const reader = new FileReader();
+    reader.onload = () => resolve({ fileName: file.name, mediaType, data: String(reader.result).split(",")[1] ?? "" });
+    reader.onerror = () => reject(new Error("That file couldn't be read. Try another copy."));
+    reader.readAsDataURL(file);
+  });
+}
diff --git a/client/src/components/ClubFinder.tsx b/client/src/components/ClubFinder.tsx
new file mode 100644
index 0000000..31a735e
--- /dev/null
+++ b/client/src/components/ClubFinder.tsx
@@ -0,0 +1,257 @@
+// Floating club finder. Asks four quick questions (major, interests, skills, résumé),
+// then shows matched clubs from the Odysc directory and takes follow-up questions.
+import { useEffect, useId, useRef, useState } from "react";
+import { Link } from "react-router-dom";
+import "../club-finder.css";
+import { findClubs, readResume, type FinderMatch, type FinderProfile, type FinderTurn, type ResumeUpload } from "../clubFinderApi";
+
+// Change if your club page route differs.
+const clubPath = (clubId: string) => `/clubs/${clubId}`;
+
+const INTERESTS = [
+  "Tech & engineering", "Business & startups", "Research", "Pre-professional",
+  "Arts & performance", "Media & writing", "Community service", "Culture & identity",
+  "Sports & outdoors", "Social",
+];
+
+type Step = "major" | "interests" | "skills" | "resume" | "thinking" | "chat";
+type Message = { id: number; from: "bot" | "me"; text: string; matches?: FinderMatch[] };
+
+const GREETING = "Hi! I'll suggest USC clubs that fit you. First, what's your major? If you haven't declared one, tell me what you're leaning toward.";
+const PLACEHOLDER: Record<Step, string> = {
+  major: "e.g. Industrial and Systems Engineering",
+  interests: "Add your own, e.g. robotics, jazz",
+  skills: "e.g. Python, video editing, public speaking",
+  resume: "Or type anything else I should know",
+  thinking: "Finding clubs…",
+  chat: "Ask for more, fewer or different clubs",
+};
+
+let nextId = 1;
+const bot = (text: string, matches?: FinderMatch[]): Message => ({ id: nextId++, from: "bot", text, matches });
+const me = (text: string): Message => ({ id: nextId++, from: "me", text });
+const turnText = (reply: string, matches: FinderMatch[]) =>
+  matches.length ? `${reply}\nSuggested: ${matches.map((m) => m.name).join(", ")}` : reply;
+
+/** Original Odysc mascot: a friendly modern-day soldier. */
+function SoldierAvatar() {
+  return (
+    <svg viewBox="0 0 64 64" width="100%" height="100%">
+      <defs><clipPath id="cf-avatar-clip"><circle cx="32" cy="32" r="30" /></clipPath></defs>
+      <g clipPath="url(#cf-avatar-clip)">
+        <circle cx="32" cy="32" r="30" fill="var(--cardinal, #990000)" />
+        <ellipse cx="32" cy="64" rx="20" ry="12" fill="#5b6b3a" />
+        <path d="M27 52 L32 57 L37 52" fill="none" stroke="#3e4a26" strokeWidth="1.5" />
+        <circle cx="32" cy="38" r="13" fill="#f2c9a0" />
+        <path d="M19 37 Q21 48 29 50.5 M45 37 Q43 48 35 50.5" fill="none" stroke="#3e4a26" strokeWidth="1.6" strokeLinecap="round" />
+        <path d="M16 35 Q16 15 32 15 Q48 15 48 35 Z" fill="#5b6b3a" />
+        <ellipse cx="32" cy="35" rx="17.5" ry="3" fill="#4a5830" />
+        <circle cx="25" cy="25" r="2.2" fill="#4a5830" /><circle cx="37" cy="22" r="2.6" fill="#4a5830" /><circle cx="41" cy="29" r="1.8" fill="#4a5830" />
+        <circle cx="27" cy="40.5" r="1.7" fill="#3a2418" /><circle cx="37" cy="40.5" r="1.7" fill="#3a2418" />
+        <circle cx="24" cy="44.5" r="2" fill="#e8a587" opacity="0.7" /><circle cx="40" cy="44.5" r="2" fill="#e8a587" opacity="0.7" />
+        <path d="M28 45.5 q4 3.2 8 0" fill="none" stroke="#3a2418" strokeWidth="1.5" strokeLinecap="round" />
+      </g>
+    </svg>
+  );
+}
+
+/** avatarSrc: optional image for the launcher (e.g. USC-approved artwork in /public). */
+export default function ClubFinder({ avatarSrc }: { avatarSrc?: string } = {}) {
+  const [open, setOpen] = useState(false);
+  const [step, setStep] = useState<Step>("major");
+  const [messages, setMessages] = useState<Message[]>([bot(GREETING)]);
+  const [draft, setDraft] = useState("");
+  const [profile, setProfile] = useState<FinderProfile>({ major: "", interests: [], skills: "" });
+  const [picked, setPicked] = useState<string[]>([]);
+  const [resumeSummary, setResumeSummary] = useState<string>();
+  const [history, setHistory] = useState<FinderTurn[]>([]);
+  const [error, setError] = useState("");
+  const launcher = useRef<HTMLButtonElement>(null);
+  const input = useRef<HTMLInputElement>(null);
+  const fileInput = useRef<HTMLInputElement>(null);
+  const log = useRef<HTMLDivElement>(null);
+  const panelId = useId();
+
+  useEffect(() => { if (open) input.current?.focus(); }, [open, step]);
+  useEffect(() => { log.current?.scrollTo({ top: log.current.scrollHeight }); }, [messages, step]);
+
+  const close = () => { setOpen(false); launcher.current?.focus(); };
+  const say = (...items: Message[]) => setMessages((current) => [...current, ...items]);
+
+  const recommend = async (finalProfile: FinderProfile, resume?: ResumeUpload) => {
+    setStep("thinking");
+    setError("");
+    try {
+      const result = await findClubs({ profile: finalProfile, resume, resumeSummary, history: [] });
+      if (result.resumeSummary) setResumeSummary(result.resumeSummary);
+      say(bot(result.reply, result.matches));
+      setHistory([{ role: "assistant", content: turnText(result.reply, result.matches) }]);
+      setStep("chat");
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : "The club finder couldn't answer. Try again.");
+      setStep("resume");
+    }
+  };
+
+  const followUp = async (text: string) => {
+    const nextHistory: FinderTurn[] = [...history, { role: "user", content: text }];
+    setStep("thinking");
+    setError("");
+    try {
+      // Sent history: even length, starts with assistant, ends with the student (max 20).
+      const result = await findClubs({ profile, resumeSummary, history: nextHistory.slice(-20) });
+      say(bot(result.reply, result.matches));
+      // Kept history: odd length, starts and ends with assistant, so the next send stays at 20.
+      const kept: FinderTurn[] = [...nextHistory, { role: "assistant", content: turnText(result.reply, result.matches) }];
+      setHistory(kept.slice(-19));
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : "The club finder couldn't answer. Try again.");
+    } finally {
+      setStep("chat");
+    }
+  };
+
+  const send = () => {
+    const text = draft.trim();
+    if (!text || step === "thinking") return;
+    setDraft("");
+    say(me(text));
+    if (step === "major") {
+      setProfile((p) => ({ ...p, major: text }));
+      say(bot("Nice. What are you into? Pick any that fit, or type your own."));
+      setStep("interests");
+    } else if (step === "interests") {
+      setPicked((current) => (current.includes(text) ? current : [...current, text]));
+    } else if (step === "skills") {
+      setProfile((p) => ({ ...p, skills: text }));
+      say(bot("Last one: want to add your résumé? I'll use it to spot experience you didn't mention. It's only used for this search and isn't saved."));
+      setStep("resume");
+    } else if (step === "resume") {
+      const finalProfile = { ...profile, skills: [profile.skills, text].filter(Boolean).join(". ") };
+      setProfile(finalProfile);
+      void recommend(finalProfile);
+    } else if (step === "chat") {
+      void followUp(text);
+    }
+  };
+
+  const confirmInterests = () => {
+    setProfile((p) => ({ ...p, interests: picked }));
+    say(me(picked.length ? picked.join(", ") : "Not sure yet"), bot("What are you good at, or want to get better at? Technical skills, creative ones, leadership, anything counts."));
+    setStep("skills");
+  };
+
+  const attachResume = async (file?: File) => {
+    if (!file) return;
+    setError("");
+    try {
+      const resume = await readResume(file);
+      say(me(`Attached ${resume.fileName}`));
+      void recommend(profile, resume);
+    } catch (failure) {
+      setError(failure instanceof Error ? failure.message : "That file couldn't be read.");
+    } finally {
+      if (fileInput.current) fileInput.current.value = "";
+    }
+  };
+
+  const restart = () => {
+    setMessages([bot(GREETING)]);
+    setProfile({ major: "", interests: [], skills: "" });
+    setPicked([]);
+    setResumeSummary(undefined);
+    setHistory([]);
+    setError("");
+    setDraft("");
+    setStep("major");
+  };
+
+  return (
+    <div className="cf" onKeyDown={(event) => { if (event.key === "Escape" && open) close(); }}>
+      {open && (
+        <section id={panelId} className="cf-panel" role="dialog" aria-modal="false" aria-labelledby={`${panelId}-title`}>
+          <header className="cf-head">
+            <div>
+              <h2 id={`${panelId}-title`} className="cf-title">Find your clubs</h2>
+              <p className="cf-sub">Matches from clubs listed on Odysc</p>
+            </div>
+            <div className="cf-head-actions">
+              {step !== "major" && <button type="button" className="btn sm ghost" onClick={restart}>Start over</button>}
+              <button type="button" className="cf-close" onClick={close} aria-label="Close club finder">×</button>
+            </div>
+          </header>
+
+          <div className="cf-log" ref={log} aria-live="polite">
+            {messages.map((message) => (
+              <div key={message.id} className={`cf-msg ${message.from}`}>
+                <p>{message.text}</p>
+                {message.matches && message.matches.length > 0 && (
+                  <ol className="cf-matches">
+                    {message.matches.map((match) => (
+                      <li key={match.clubId} className="cf-match">
+                        <div className="cf-match-top">
+                          <Link to={clubPath(match.clubId)} className="cf-match-name" onClick={() => setOpen(false)}>{match.name}</Link>
+                          <span className={`cf-fit ${match.fit}`}>{match.fit === "strong" ? "Strong fit" : "Good fit"}</span>
+                        </div>
+                        <p className="cf-reason">{match.reason}</p>
+                      </li>
+                    ))}
+                  </ol>
+                )}
+              </div>
+            ))}
+            {step === "thinking" && <div className="cf-msg bot cf-typing" aria-label="Finding clubs"><span /><span /><span /></div>}
+          </div>
+
+          {step === "interests" && (
+            <div className="cf-chips" role="group" aria-label="Interests">
+              {[...INTERESTS, ...picked.filter((item) => !INTERESTS.includes(item))].map((item) => {
+                const on = picked.includes(item);
+                return (
+                  <button key={item} type="button" className={`cf-chip${on ? " on" : ""}`} aria-pressed={on}
+                    onClick={() => setPicked((current) => (on ? current.filter((x) => x !== item) : [...current, item]))}>
+                    {item}
+                  </button>
+                );
+              })}
+              <button type="button" className="btn primary sm cf-continue" onClick={confirmInterests}>
+                {picked.length ? `Continue with ${picked.length}` : "Skip"}
+              </button>
+            </div>
+          )}
+
+          {step === "resume" && (
+            <div className="cf-chips">
+              <input ref={fileInput} type="file" accept=".pdf,.txt,application/pdf,text/plain" hidden onChange={(event) => { void attachResume(event.target.files?.[0]); }} />
+              <button type="button" className="btn primary sm" onClick={() => fileInput.current?.click()}>Upload résumé (PDF)</button>
+              <button type="button" className="btn sm" onClick={() => { say(me("Skip the résumé")); void recommend(profile); }}>Skip and show clubs</button>
+            </div>
+          )}
+
+          {error && <p className="field-error cf-error" role="alert">{error}</p>}
+
+          <form className="cf-compose" onSubmit={(event) => { event.preventDefault(); send(); }}>
+            <label className="sr-only" htmlFor={`${panelId}-input`}>Message</label>
+            <input id={`${panelId}-input`} ref={input} className="input" value={draft} maxLength={1000}
+              placeholder={PLACEHOLDER[step]} disabled={step === "thinking"} onChange={(event) => setDraft(event.target.value)} />
+            <button type="submit" className="btn primary" disabled={!draft.trim() || step === "thinking"}>Send</button>
+          </form>
+        </section>
+      )}
+
+      <button ref={launcher} type="button" className={`cf-launcher${open ? " open" : ""}`} aria-expanded={open} aria-controls={panelId}
+        aria-label={open ? "Close club finder" : "Ask me! Open the club finder"}
+        onClick={() => (open ? close() : setOpen(true))}>
+        {!open && (
+          <span className="cf-thought" aria-hidden="true">
+            Ask me!
+            <span className="cf-thought-dot big" /><span className="cf-thought-dot small" />
+          </span>
+        )}
+        <span className="cf-avatar" aria-hidden="true">
+          {open ? <span className="cf-avatar-x">×</span> : avatarSrc ? <img src={avatarSrc} alt="" /> : <SoldierAvatar />}
+        </span>
+      </button>
+    </div>
+  );
+}
