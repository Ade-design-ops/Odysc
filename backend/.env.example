PORT=3001
HOST=127.0.0.1
DATABASE_BACKEND=supabase
# Used only when DATABASE_BACKEND=sqlite is selected explicitly for a local demo.
DATABASE_PATH=./data/odysc.sqlite
RESUME_DIRECTORY=./data/resumes
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# Backend origin used by confirmation and recovery email links. Add its
# /auth/callback URL to Supabase Authentication > URL Configuration.
AUTH_PUBLIC_ORIGIN=http://localhost:3001
# Frontend destination after verification. Current Vite app uses port 5173.
AUTH_FRONTEND_ORIGIN=http://localhost:5173
# Match the frontend router: hash for current HashRouter, history for BrowserRouter.
AUTH_FRONTEND_ROUTING=hash
# At least 32 random characters; generate locally, keep stable and private.
# Required in production. Rotating this signs out browser sessions.
AUTH_COOKIE_SECRET=
# Supabase student login/profile integration (publishable key, not a secret key).
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
# USC-only access is the default. Blank is an explicit local-test opt-out;
# it does not disable Supabase's signup hook or database access policy.
# Shared USC migration is applied. New projects must also install the migration
# and enable its signup hook. See docs/USC_EMAIL_ACCESS.md.
STUDENT_EMAIL_DOMAIN=usc.edu
# Server-only, verified PostgreSQL connection for club reads, shared workflow
# writes, and operator commands. Native profile API writes use the student JWT.
# Paste the full Postgres connection URI locally; never put it in chat or Git.
SUPABASE_DB_URL=
# Required for shared workflows: path to Supabase's downloaded root CA certificate.
SUPABASE_DB_CA_FILE=
# Optional: all demo flows work locally without an AI key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Only use disposable demo data when enabling this locally.
SEED_DEMO=false
NODE_ENV=development
